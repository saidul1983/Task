@model NewsLetterBoxModel

<div class="col-md-3">
    <div class="footer-nav-header">
        <h5 class="text-uppercase font-weight-bold"> @T("Newsletter.Title") </h5>

        <div class="newsletter-content">
            <a class="img-fluid" href="index.html">
                @await Component.InvokeAsync(typeof(LogoViewComponent))
            </a>

            <p class="pt-4 mb-0">Subscribe Newsletter</p>

            <div class="input-group md-form form-sm form-2 pl-0">

                <input asp-for="NewsLetterEmail" id="newsletter-email" class="form-control my-0 py-1 red-border" type="text" placeholder=@T("Newsletter.Email.Placeholder") aria-label="@T("Newsletter.Subscribe")" />

                <div class="input-group-append">
                    <button class="input-group-text lighten-3" type="button" id="newsletter-subscribe-button">
                        <i class="fas fa-arrow-right"></i>
                    </button>
                </div>

            </div>

            @if (Model.AllowToUnsubscribe)
            {
                <div class="options">
                    <span class="subscribe">
                        <input id="newsletter_subscribe" type="radio" value="newsletter_subscribe" name="newsletter_block" checked="checked" />
                        <label for="newsletter_subscribe">@T("Newsletter.Options.Subscribe")</label>
                    </span>
                    <span class="unsubscribe">
                        <input id="newsletter_unsubscribe" type="radio" value="newsletter_unsubscribe" name="newsletter_block" />
                        <label for="newsletter_unsubscribe">@T("Newsletter.Options.Unsubscribe")</label>
                    </span>
                </div>
            }

        </div>

    </div>
</div>