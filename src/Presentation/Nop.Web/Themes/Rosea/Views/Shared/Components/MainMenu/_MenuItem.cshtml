@model MenuItemModel

@{
    var expanded = Model.ChildrenItems.Any() ? $"aria-expanded=false aria-haspopup=true data-toggle=dropdown class=dropdown-toggle" : "class=dropdown-item";
    var href = !string.IsNullOrEmpty(Model.Url) ? $"href={Model.Url}" : "";    
}
<a @href @expanded role="button" tabindex="0">@Model.Title</a>





