@model SocialModel
<div class="social-media-icon">
    @if (!string.IsNullOrEmpty(Model.FacebookLink))
    {
        <a href="@Model.FacebookLink" target="_blank" rel="noopener noreferrer"> <i class="fab fa-facebook-square" aria-hidden="true"></i> </a>
    }
    @if (!string.IsNullOrEmpty(Model.TwitterLink))
    {
        <a href="@Model.TwitterLink" target="_blank" rel="noopener noreferrer"> <i class="fab fa-twitter-square" aria-hidden="true"></i> </a>
    }
    @if (Model.NewsEnabled)
    {
        <a href="@Url.RouteUrl(NopRouteNames.Standard.NEWS_RSS, new { languageId = Model.WorkingLanguageId })" target="_blank" rel="noopener noreferrer"> <i class="fab fa-hacker-news-square" aria-hidden="true"></i> </a>
    }
    @if (!string.IsNullOrEmpty(Model.YoutubeLink))
    {
        <a href="@Model.YoutubeLink" target="_blank" rel="noopener noreferrer"> <i class="fab fa-youtube-square" aria-hidden="true"></i> </a>
    }
    @if (!string.IsNullOrEmpty(Model.InstagramLink))
    {
        <a href="@Model.InstagramLink" target="_blank" rel="noopener noreferrer"> <i class="fab fa-instagram" aria-hidden="true"></i> </a>
    }
</div>