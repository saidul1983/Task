@model IList<CategoryModel>

@using Nop.Core.Domain.Catalog

@if (Model.Count > 0)
{
    <div class="category-slider">
        <div class="owl-carousel owl-theme" id="category-slider">
            @foreach (var item in Model)
            {
                <div class="item">
                    <div class="categories-main-box">
                        <a href="@(await NopUrl.RouteGenericUrlAsync<Category>(new { SeName = item.SeName }))">
                            <h5 href="@(await NopUrl.RouteGenericUrlAsync<Category>(new { SeName = item.SeName }))" title="@item.PictureModel.Title"> @item.Name <i class="fas fa-angle-right"></i> </h5>
                            <img class="img-fluid" src="@item.PictureModel.ImageUrl" alt="@item.PictureModel.AlternateText">
                        </a>
                    </div>
                </div>
            }
        </div>
    </div>
}