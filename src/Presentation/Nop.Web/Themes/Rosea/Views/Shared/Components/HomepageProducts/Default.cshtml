@model IList<ProductOverviewModel>
@if (Model.Count > 0)
{
    <section class="products-details-page">
        <h2 class="text-uppercase mb-3">
            @T("Homepage.Products")
        </h2>
        <div class="products-slider">
            <div class="products-slider">
                <div class="owl-carousel owl-theme" id="products-slider">
                    @foreach (var item in Model)
                    {
                        <div class="item">
                            @await Html.PartialAsync("_ProductBox", item)
                        </div>
                    }
                </div>
            </div>
        </div>
    </section>
}